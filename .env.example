# Copy to .dev.vars for the local Worker runtime. Never prefix with VITE_ or NEXT_PUBLIC_.
# Hosted deployments: configure these as server environment variables / secrets.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Choose a model supporting image input, Responses API, and strict JSON Schema.
OPENAI_MODEL=gpt-5-mini
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable: changing it invalidates grading with existing signed rubrics.
STATREPORT_SIGNING_SECRET=
# Timeout per provider request, clamped to 1–120 seconds. Grading includes two requests.
AI_TIMEOUT_MS=90000
